{
  "name": "Штриховая мастерская",
  "short_name": "Мастерская",
  "description": "Сборка промптов иллюстраций для карточек персонажей",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#121316",
  "theme_color": "#121316",
  "lang": "ru",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "file", "accept": ["application/json", "text/html", "text/plain", ".json", ".html", ".txt"] }
      ]
    }
  },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
